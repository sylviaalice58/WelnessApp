<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#7AABFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<!--    Below is a linear layout that holds all our views-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:orientation="vertical">


<!--     Below is a textview-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health and Wellness App"
            android:textSize="45sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#CE175B"/>

<!--        below is an image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/image1"
            android:layout_marginTop="15dp"/>

        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111"/>


<!--        below is button number 1-->
        <Button
            android:id="@+id/health_recipes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="#EBCBAC"
            android:drawableLeft="@drawable/recipe"
            android:text="Healthy Recipes"
            android:textSize="20sp" />

<!--        Below is button number 2-->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nutrition_advice"
            android:text="Nutrition Advice"
            android:drawableLeft="@drawable/diet"
            android:textSize="20sp"
            android:backgroundTint="#EBCBAC"
            android:layout_marginTop="15dp"/>

<!--       Below is button number 3-->

        <!-- Below is button number 4-->
        <Button
            android:id="@+id/meditation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/meditation"
            android:layout_marginTop="15dp"
            android:backgroundTint="#EBCBAC"
            android:text="Meditation"
            android:textSize="20sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/hydration_alert"
            android:text="Hydration Alert"
            android:drawableLeft="@drawable/hydrated"
            android:textSize="20sp"
            android:backgroundTint="#EBCBAC"
            android:layout_marginTop="15dp"/>

        <!-- Below is button number 5-->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/start_exercise"
            android:text="Start Exercise"
            android:drawableLeft="@drawable/exercise"
            android:textSize="20sp"
            android:backgroundTint="#EBCBAC"
            android:layout_marginTop="15dp"/>

        <!-- Below is button number 6-->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/daily_motivation"
            android:text="Dairly Motivation"
            android:drawableLeft="@drawable/team"
            android:textSize="20sp"
            android:backgroundTint="#EBCBAC"
            android:layout_marginTop="15dp"/>

        <!-- Below is button number 7-->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/weekly_goals"
            android:text="Weekly Goals"
            android:drawableLeft="@drawable/team"
            android:textSize="20sp"
            android:backgroundTint="#EBCBAC"
            android:layout_marginTop="15dp"/>

        <!-- Below is button number 8-->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/check_progress"
            android:text="Check Progress"
            android:drawableLeft="@drawable/improve"
            android:textSize="20sp"
            android:backgroundTint="#EBCBAC"
            android:layout_marginTop="15dp"/>

            <!-- Below is button number 9-->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/learnmore"
                android:text="Learn More ..."
                android:drawableLeft="@drawable/reading"
                android:textSize="20sp"
                android:backgroundTint="#EBCBAC"
                android:layout_marginTop="15dp"/>



    </LinearLayout>

</ScrollView>