<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProgressActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#71c8e0">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress"
            android:textSize="34sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#0345D9"/>

        <!-- Progress Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track Your Progress"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Progress Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tracking your progress helps you stay motivated and see how much you have improved over time."
            android:textSize="16sp"
            android:textColor="#000"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="16dp" />

<!--        image-->

        <!-- Weekly Progress Content -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:src="@drawable/progress"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Drank enough water: 5/7 days&#10;&#10;• Exercised: 4/7 days&#10;&#10;• Slept 7–9 hours: 6/7 days&#10;&#10;• Ate healthy meals: 5/7 days&#10;&#10;• Practiced mindfulness: 3/7 days"
            android:textSize="16sp"
            android:textColor="#000"
            android:lineSpacingExtra="8dp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Encouragement Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep going! Every small step brings you closer to your goals."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#065F46"
            android:gravity="center"
            android:padding="16dp"
            android:background="#D1FAE5"
            android:layout_marginBottom="20dp" />


    </LinearLayout>

</ScrollView>